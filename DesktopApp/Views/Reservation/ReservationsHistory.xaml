<Window x:Class="DesktopApp.Views.Reservation.ReservationsHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp.Views.Reservation"
        mc:Ignorable="d"
        Title="Historial de Reserva"
        Width="1200"
        Height="650"
        MinWidth="1000"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/images/icoproyecto.ico">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="50 20 0 20" Orientation="Horizontal" HorizontalAlignment="Center">
            <CheckBox Content="Confirmadas"
                      Margin="0,0,20,10"
                      VerticalAlignment="Center"
                      IsChecked="{Binding MostrarConfirmadas, Mode=TwoWay}"/>

            <CheckBox Content="Canceladas"
                      Margin="0,0,20,10"
                      VerticalAlignment="Center"
                      IsChecked="{Binding MostrarCanceladas, Mode=TwoWay}"/>

            <CheckBox Content="CheckIn"
                      Margin="0,0,20,10"
                      VerticalAlignment="Center"
                      IsChecked="{Binding  MostrarCheckIn, Mode=TwoWay}"/>

            <CheckBox Content="CheckOut"
                      Margin="0,0,20,10"
                      VerticalAlignment="Center"
                      IsChecked="{Binding MostrarCheckOut, Mode=TwoWay}"/>

            <Button Content="Limpiar"
                    Style="{StaticResource ActionButton}"
                    Background="#6B7280"
                    Command="{Binding LimpiarLogCommand}"
                    Width="50"
                    Margin="0 0 0 10"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="dgReservation"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding AuditLog}"
                      SelectedItem="{Binding ReservaAuditLog, Mode=TwoWay}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanUserResizeColumns="True">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding Timestamp, StringFormat=dd/MM/yyyy}"
                                        Width="110"/>

                    <DataGridTextColumn Header="DNI"
                                        Binding="{Binding UserDNI}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding UserNombre}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Rol"
                                        Binding="{Binding ActorType}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Acción"
                                        Binding="{Binding Action}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Estado anterior"
                                        Binding="{Binding PreviousState.Status, TargetNullValue='Sin estado', FallbackValue='Nada'}"
                                        Width="140"/>

                    <DataGridTextColumn Header="Estado nuevo"
                                        Binding="{Binding NewState.Status, TargetNullValue='Sin estado', FallbackValue='Nada'}"
                                        Width="130"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    Background="#F8FAFC"
                    BorderBrush="#DADFE7"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Detalle del historial"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Estado Anterior"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Estado"
                                    FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.PreviousState.Status,
                                                  TargetNullValue='Sin estado',
                                                  FallbackValue='Nada'}"
                                    Margin="0,0,0,20"/>

                        <TextBlock Text="Observaciones"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="{Binding ReservaAuditLog.PreviousState.Comentario,
                                                  TargetNullValue='Sin observaciones',
                                                  FallbackValue='Nada'}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Check-in"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.PreviousState.CheckIn,
                                                   StringFormat=dd/MM/yyyy,
                                                   TargetNullValue='Sin fecha',
                                                   FallbackValue='Nada'}"
                                    Margin="0,0,0,15"/>

                        <TextBlock Text="Check-out"
                                    FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.PreviousState.CheckOut,
                                                StringFormat=dd/MM/yyyy,
                                                TargetNullValue='Sin fecha',
                                                FallbackValue='Nada'}"
                                    Margin="0,0,0,15"/>

                        <TextBlock Text="Habitaciones"
                                    FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.PreviousState.RoomNumbers,
                                                    TargetNullValue='Sin Habitaciones',
                                                    FallbackValue='Nada'}"
                                    Margin="0,0,0,15"/>

                        <TextBlock Text="Huespedes"
                                    FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.PreviousState.Guest,
                                                  TargetNullValue='Sin huéspedes',
                                                  FallbackValue='Nada'}"
                                   Margin="0,5,0,15"/>
                        <Separator Margin="0,5,0,15"/>

                        <TextBlock Text="Estado Nuevo"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Estado"
                                    FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.NewState.Status,
                                                  TargetNullValue='Sin estado',
                                                  FallbackValue='Nada'}"
                                   Margin="0,0,0,20"/>


                        <TextBlock Text="Observaciones"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>       

                        <TextBlock Text="{Binding ReservaAuditLog.NewState.Comentario,
                                                  TargetNullValue='Sin observaciones',
                                                  FallbackValue='Nada'}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Check-in"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.NewState.CheckIn,
                                                  StringFormat=dd/MM/yyyy,
                                                  TargetNullValue='Sin fecha',
                                                   FallbackValue='Nada'}"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Check-out"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.NewState.CheckOut,
                                                  StringFormat=dd/MM/yyyy,
                                                  TargetNullValue='Sin fecha',
                                                  FallbackValue='Nada'}"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Habitaciones"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.NewState.RoomNumbers,
                                                  TargetNullValue='Sin Habitaciones',
                                                   FallbackValue='Nada'}"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Huespedes"
                                FontWeight="Bold"/>

                        <TextBlock Text="{Binding ReservaAuditLog.NewState.Guest,
                                                    TargetNullValue='Sin huéspedes',
                                                    FallbackValue='Nada'}"/>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
<Window x:Class="DesktopApp.Views.RoomCalendarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopApp.Views"
        mc:Ignorable="d"
        Title="Calendario de habitación"
        Height="780"
        Width="1100"
        MinHeight="760"
        MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/images/icoproyecto.ico"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Calendario mensual por habitación"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="Selecciona dos días libres para crear un bloqueo manual."
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Rooms}"
                          SelectedItem="{Binding SelectedRoom}"
                          DisplayMemberPath="numRoom"
                          Height="36"
                          VerticalAlignment="Center"
                          Margin="20,0,10,0"/>

                <Button Grid.Column="2"
                        Content="Anterior"
                        Style="{StaticResource ActionButton}"
                        Background="#6B7280"
                        Command="{Binding PreviousMonthCommand}"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="3"
                        Content="Siguiente"
                        Style="{StaticResource ActionButton}"
                        Command="{Binding NextMonthCommand}"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding MonthTitle}"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#111827"/>

        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Columns="7">
                    <TextBlock Text="Lunes" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Martes" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Miércoles" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Jueves" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Viernes" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Sábado" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Text="Domingo" FontWeight="Bold" TextAlignment="Center"/>
                </UniformGrid>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Background}"
                                    CornerRadius="12"
                                    Margin="3"
                                    MinHeight="92"
                                    Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding DayNumber}"
                                           FontSize="20"
                                           FontWeight="Black"
                                           Foreground="{Binding Foreground}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Info}"
                                           Foreground="Black"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>                                        
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" 
                                                Orientation="Vertical"
                                                HorizontalAlignment="Right">
                                        <Border Background="{StaticResource BackgroundBrush2}" CornerRadius="12">
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                        Command="{Binding DataContext.DayClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                <Path Stroke="{StaticResource CancelBrush}"
                                                            Width="20"
                                                            Height="20"
                                                            Stretch="Uniform"
                                                            Data="{StaticResource IcoBlock}" Margin="4"/>
                                            </Button>
                                        </Border>
                                        <Separator Height="5" Background="Transparent"/>
                                        <Border Background="{StaticResource BackgroundBrush2}" CornerRadius="12">
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                Command="{Binding DataContext.DeleteBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                                <Path Stroke="{StaticResource OkBrush}"
                                                    Width="20"
                                                    Height="20"
                                                    Stretch="Uniform"
                                                    Data="{StaticResource IcoOpen}" Margin="2"/>
                                            </Button>
                                        </Border>

                                        
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <Rectangle Width="18" Height="18" Fill="{StaticResource CalendarBrush}" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Libre" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <Rectangle Width="18" Height="18" Fill="{StaticResource UpdateBrush}" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Ocupado" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <Rectangle Width="18" Height="18" Fill="{StaticResource CancelBrush}" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Bloqueado" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <Rectangle Width="18" Height="18" Fill="{StaticResource AccentBrush}" RadiusX="4" RadiusY="4"/>
                        <TextBlock Text="Seleccionado" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
